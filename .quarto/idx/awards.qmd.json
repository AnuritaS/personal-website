{"markdown":{"yaml":{"title":"","page-layout":"full","toc":false},"containsRefs":false,"markdown":"\n\n```{=html}\n<div class=\"page-hero\">\n  <div class=\"content-section-impact\" style=\"padding-top:0;padding-bottom:0;\">\n    <p class=\"eyebrow\">Recognition</p>\n    <h1 style=\"font-size:2rem;margin-bottom:0.4rem;\">Awards &amp; Honors</h1>\n    <p style=\"color:#4A6A88;font-size:0.9rem;max-width:500px;line-height:1.6;\">\n      Third-party validation of evidence-backed work across policy research, \n      program evaluation, and public service.\n    </p>\n  </div>\n</div>\n\n<!-- Trophy shelf -->\n<div class=\"content-section-impact\">\n  <div class=\"section-divider\">Top honors</div>\n  <div class=\"trophy-shelf\">\n    <div class=\"trophy-card\">\n      <div class=\"trophy-star\">★</div>\n      <div class=\"trophy-name\">Public Service Excellence Award</div>\n      <div class=\"trophy-org\">NASPE</div>\n      <div class=\"trophy-year\">2024</div>\n    </div>\n    <div class=\"trophy-card\">\n      <div class=\"trophy-star\">★</div>\n      <div class=\"trophy-name\">Emerging Evaluator Award</div>\n      <div class=\"trophy-org\">American Evaluation Association</div>\n      <div class=\"trophy-year\">2023</div>\n    </div>\n    <div class=\"trophy-card\">\n      <div class=\"trophy-star\">★</div>\n      <div class=\"trophy-name\">HHS Innovation Grant Recipient</div>\n      <div class=\"trophy-org\">Dept. of Health &amp; Human Services</div>\n      <div class=\"trophy-year\">2022</div>\n    </div>\n  </div>\n</div>\n\n<!-- Full recognition timeline -->\n<div class=\"tinted-band\">\n  <div class=\"content-section-impact\">\n    <div class=\"section-divider\">All recognition</div>\n    <div class=\"recognition-list\">\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Mar 2026</div>\n        <div>\n          <div class=\"rec-title\">Invited speaker — AEA 2026 Annual Conference</div>\n          <div class=\"rec-org\">American Evaluation Association</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Nov 2025</div>\n        <div>\n          <div class=\"rec-title\">\"40 Under 40 in Public Policy\" — featured profile</div>\n          <div class=\"rec-org\">Governing Magazine</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Jun 2024</div>\n        <div>\n          <div class=\"rec-title\">Public Service Excellence Award</div>\n          <div class=\"rec-org\">National Association of State Personnel Executives (NASPE)</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Oct 2023</div>\n        <div>\n          <div class=\"rec-title\">Emerging Evaluator Award</div>\n          <div class=\"rec-org\">American Evaluation Association</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Jun 2023</div>\n        <div>\n          <div class=\"rec-title\">Peer-reviewed publication — Journal of Policy Analysis &amp; Management</div>\n          <div class=\"rec-org\">\"Implementation fidelity in decentralized workforce programs\"</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Sep 2022</div>\n        <div>\n          <div class=\"rec-title\">Congressional testimony — House Education &amp; Workforce Committee</div>\n          <div class=\"rec-org\">U.S. House of Representatives</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Apr 2022</div>\n        <div>\n          <div class=\"rec-title\">HHS Innovation Grant Recipient</div>\n          <div class=\"rec-org\">Dept. of Health &amp; Human Services · $340,000 research grant</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">2021–23</div>\n        <div>\n          <div class=\"rec-title\">7 peer-reviewed publications</div>\n          <div class=\"rec-org\">Co-authored with Urban Institute research team · DOL and HHS program evaluations</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- Media -->\n<div class=\"content-section-impact\">\n  <div class=\"section-divider\">Media &amp; press</div>\n  <div class=\"grid-2\">\n    <div style=\"background:#fff;border:1px solid #D0DFF0;border-radius:10px;padding:1rem 1.2rem;display:flex;gap:1rem;align-items:flex-start;\">\n      <div style=\"font-size:1.5rem;\">📰</div>\n      <div>\n        <div style=\"font-size:0.75rem;font-weight:600;color:#8AA4C0;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:3px;\">Governing Magazine</div>\n        <div style=\"font-size:0.88rem;font-weight:500;color:#1A3A5C;margin-bottom:3px;\">\"40 Under 40 in Public Policy\" feature</div>\n        <div style=\"font-size:0.78rem;color:#4A6A88;\">Nov 2025</div>\n      </div>\n    </div>\n    <div style=\"background:#fff;border:1px solid #D0DFF0;border-radius:10px;padding:1rem 1.2rem;display:flex;gap:1rem;align-items:flex-start;\">\n      <div style=\"font-size:1.5rem;\">🎙️</div>\n      <div>\n        <div style=\"font-size:0.75rem;font-weight:600;color:#8AA4C0;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:3px;\">Evidence Matters Podcast</div>\n        <div style=\"font-size:0.88rem;font-weight:500;color:#1A3A5C;margin-bottom:3px;\">\"Designing evaluations that survive the field\"</div>\n        <div style=\"font-size:0.78rem;color:#4A6A88;\">Feb 2024</div>\n      </div>\n    </div>\n  </div>\n</div>\n```\n","srcMarkdownNoYaml":"\n\n```{=html}\n<div class=\"page-hero\">\n  <div class=\"content-section-impact\" style=\"padding-top:0;padding-bottom:0;\">\n    <p class=\"eyebrow\">Recognition</p>\n    <h1 style=\"font-size:2rem;margin-bottom:0.4rem;\">Awards &amp; Honors</h1>\n    <p style=\"color:#4A6A88;font-size:0.9rem;max-width:500px;line-height:1.6;\">\n      Third-party validation of evidence-backed work across policy research, \n      program evaluation, and public service.\n    </p>\n  </div>\n</div>\n\n<!-- Trophy shelf -->\n<div class=\"content-section-impact\">\n  <div class=\"section-divider\">Top honors</div>\n  <div class=\"trophy-shelf\">\n    <div class=\"trophy-card\">\n      <div class=\"trophy-star\">★</div>\n      <div class=\"trophy-name\">Public Service Excellence Award</div>\n      <div class=\"trophy-org\">NASPE</div>\n      <div class=\"trophy-year\">2024</div>\n    </div>\n    <div class=\"trophy-card\">\n      <div class=\"trophy-star\">★</div>\n      <div class=\"trophy-name\">Emerging Evaluator Award</div>\n      <div class=\"trophy-org\">American Evaluation Association</div>\n      <div class=\"trophy-year\">2023</div>\n    </div>\n    <div class=\"trophy-card\">\n      <div class=\"trophy-star\">★</div>\n      <div class=\"trophy-name\">HHS Innovation Grant Recipient</div>\n      <div class=\"trophy-org\">Dept. of Health &amp; Human Services</div>\n      <div class=\"trophy-year\">2022</div>\n    </div>\n  </div>\n</div>\n\n<!-- Full recognition timeline -->\n<div class=\"tinted-band\">\n  <div class=\"content-section-impact\">\n    <div class=\"section-divider\">All recognition</div>\n    <div class=\"recognition-list\">\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Mar 2026</div>\n        <div>\n          <div class=\"rec-title\">Invited speaker — AEA 2026 Annual Conference</div>\n          <div class=\"rec-org\">American Evaluation Association</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Nov 2025</div>\n        <div>\n          <div class=\"rec-title\">\"40 Under 40 in Public Policy\" — featured profile</div>\n          <div class=\"rec-org\">Governing Magazine</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Jun 2024</div>\n        <div>\n          <div class=\"rec-title\">Public Service Excellence Award</div>\n          <div class=\"rec-org\">National Association of State Personnel Executives (NASPE)</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Oct 2023</div>\n        <div>\n          <div class=\"rec-title\">Emerging Evaluator Award</div>\n          <div class=\"rec-org\">American Evaluation Association</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Jun 2023</div>\n        <div>\n          <div class=\"rec-title\">Peer-reviewed publication — Journal of Policy Analysis &amp; Management</div>\n          <div class=\"rec-org\">\"Implementation fidelity in decentralized workforce programs\"</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Sep 2022</div>\n        <div>\n          <div class=\"rec-title\">Congressional testimony — House Education &amp; Workforce Committee</div>\n          <div class=\"rec-org\">U.S. House of Representatives</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">Apr 2022</div>\n        <div>\n          <div class=\"rec-title\">HHS Innovation Grant Recipient</div>\n          <div class=\"rec-org\">Dept. of Health &amp; Human Services · $340,000 research grant</div>\n        </div>\n      </div>\n      <div class=\"rec-row\">\n        <div class=\"rec-date\">2021–23</div>\n        <div>\n          <div class=\"rec-title\">7 peer-reviewed publications</div>\n          <div class=\"rec-org\">Co-authored with Urban Institute research team · DOL and HHS program evaluations</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- Media -->\n<div class=\"content-section-impact\">\n  <div class=\"section-divider\">Media &amp; press</div>\n  <div class=\"grid-2\">\n    <div style=\"background:#fff;border:1px solid #D0DFF0;border-radius:10px;padding:1rem 1.2rem;display:flex;gap:1rem;align-items:flex-start;\">\n      <div style=\"font-size:1.5rem;\">📰</div>\n      <div>\n        <div style=\"font-size:0.75rem;font-weight:600;color:#8AA4C0;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:3px;\">Governing Magazine</div>\n        <div style=\"font-size:0.88rem;font-weight:500;color:#1A3A5C;margin-bottom:3px;\">\"40 Under 40 in Public Policy\" feature</div>\n        <div style=\"font-size:0.78rem;color:#4A6A88;\">Nov 2025</div>\n      </div>\n    </div>\n    <div style=\"background:#fff;border:1px solid #D0DFF0;border-radius:10px;padding:1rem 1.2rem;display:flex;gap:1rem;align-items:flex-start;\">\n      <div style=\"font-size:1.5rem;\">🎙️</div>\n      <div>\n        <div style=\"font-size:0.75rem;font-weight:600;color:#8AA4C0;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:3px;\">Evidence Matters Podcast</div>\n        <div style=\"font-size:0.88rem;font-weight:500;color:#1A3A5C;margin-bottom:3px;\">\"Designing evaluations that survive the field\"</div>\n        <div style=\"font-size:0.78rem;color:#4A6A88;\">Feb 2024</div>\n      </div>\n    </div>\n  </div>\n</div>\n```\n"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","merge-includes":true,"inline-includes":false,"preserve-yaml":false,"latex-auto-mk":true,"latex-auto-install":true,"latex-clean":true,"latex-min-runs":1,"latex-max-runs":10,"latex-makeindex":"makeindex","latex-makeindex-opts":[],"latex-tlmgr-opts":[],"latex-input-paths":[],"latex-output-dir":null,"link-external-icon":false,"link-external-newwindow":false,"self-contained-math":false,"format-resources":[],"notebook-links":true},"pandoc":{"standalone":true,"wrap":"none","default-image-extension":"png","to":"html","css":["styles.css"],"toc":false,"include-in-header":[{"text":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&family=Baloo+2:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n<script>\n  // Apply stored theme immediately, before first paint, to avoid a flash.\n  // Default is always \"light\" on a first visit — deliberately NOT reading\n  // prefers-color-scheme, since that follows the OS's dark mode setting,\n  // which on many systems is itself scheduled by time of day. A returning\n  // visitor's own manual toggle (saved below) is still respected.\n  (function () {\n    try {\n      var t = localStorage.getItem(\"anu-theme\") || \"light\";\n      document.documentElement.setAttribute(\"data-theme\", t);\n    } catch (e) {}\n  })();\n</script>\n"}],"include-after-body":[{"text":"<script>\n(function () {\n  \"use strict\";\n\n  var STORAGE_KEY = \"anu-theme\";\n\n  function getStoredTheme() {\n    try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }\n  }\n\n  function storeTheme(theme) {\n    try { localStorage.setItem(STORAGE_KEY, theme); } catch (e) {}\n  }\n\n  function applyTheme(theme) {\n    document.documentElement.setAttribute(\"data-theme\", theme);\n    var btn = document.getElementById(\"theme-toggle-btn\");\n    if (btn) {\n      btn.textContent = theme === \"dark\" ? \"\\u2600\\uFE0F\" : \"\\uD83C\\uDF19\";\n      var label = theme === \"dark\" ? \"Switch to day mode\" : \"Switch to night mode\";\n      btn.setAttribute(\"aria-label\", label);\n      btn.title = label;\n    }\n  }\n\n  var initial = getStoredTheme() || document.documentElement.getAttribute(\"data-theme\") || \"light\";\n\n  // ── THEME TOGGLE BUTTON ──────────────────────────────────────\n  function injectToggleButton() {\n    if (document.getElementById(\"theme-toggle-btn\")) return;\n    var btn = document.createElement(\"button\");\n    btn.id = \"theme-toggle-btn\";\n    btn.className = \"theme-toggle\";\n    btn.type = \"button\";\n    btn.addEventListener(\"click\", function () {\n      var current = document.documentElement.getAttribute(\"data-theme\");\n      var next = current === \"dark\" ? \"light\" : \"dark\";\n      applyTheme(next);\n      storeTheme(next);\n    });\n    document.body.appendChild(btn);\n    applyTheme(initial);\n  }\n\n  // ── HERO SCROLL — pinned crossfade (breedlove.xyz-style) ─────\n  // hero-section is pinned via CSS position:sticky for one extra\n  // viewport's worth of scroll (see .hero-pin-wrap height). While\n  // pinned, this fades the intro layer out and the detail layer\n  // (bio/CTAs/stats) in, directly over the photo, plus a slow\n  // background zoom. Once progress hits 1 the section unpins and\n  // the rest of the page scrolls normally.\n  function initScrollZoom() {\n    var heroBg = document.getElementById(\"hero-bg-zoom\");\n    var intro  = document.getElementById(\"hero-layer-intro\");\n    var detail = document.getElementById(\"hero-layer-detail\");\n    if (!heroBg) return;\n\n    var ticking = false;\n\n    function update() {\n      var scrollY  = window.scrollY || window.pageYOffset;\n      var viewportH = window.innerHeight || 1;\n      // progress 0 → 1 across the one extra viewport of scroll room\n      var progress = Math.min(Math.max(scrollY / viewportH, 0), 1);\n\n      var bgScale = 1 + progress * 0.18;\n      heroBg.style.transform = \"scale(\" + bgScale.toFixed(3) + \")\";\n      heroBg.style.transformOrigin = \"center center\";\n\n      if (intro) {\n        var introOpacity = Math.max(1 - progress * 1.4, 0);\n        intro.style.opacity   = introOpacity.toFixed(3);\n        intro.style.transform = \"translateY(\" + (-(progress * 24)).toFixed(1) + \"px)\";\n        intro.style.pointerEvents = introOpacity < 0.05 ? \"none\" : \"auto\";\n      }\n\n      if (detail) {\n        detail.style.opacity   = progress.toFixed(3);\n        detail.style.transform = \"translateY(\" + ((1 - progress) * 16).toFixed(1) + \"px)\";\n        detail.style.pointerEvents = progress > 0.4 ? \"auto\" : \"none\";\n      }\n\n      ticking = false;\n    }\n\n    window.addEventListener(\"scroll\", function () {\n      if (!ticking) { requestAnimationFrame(update); ticking = true; }\n    }, { passive: true });\n    window.addEventListener(\"resize\", function () {\n      if (!ticking) { requestAnimationFrame(update); ticking = true; }\n    }, { passive: true });\n\n    heroBg.style.willChange = \"transform\";\n    update();\n  }\n\n  // ── GALAXY CONSTELLATION TOOLTIPS ────────────────────────────\n  function initGalaxyTooltips() {\n    var svg = document.querySelector(\".constellation-svg\");\n    if (!svg) return;\n    var tooltip = document.getElementById(\"galaxy-tooltip\");\n    if (!tooltip) return;\n\n    var stars = svg.querySelectorAll(\".star-dot\");\n    stars.forEach(function (star) {\n      star.style.cursor = \"pointer\";\n\n      star.addEventListener(\"mouseenter\", function (e) {\n        var stat = star.getAttribute(\"data-stat\");\n        var ctx  = star.getAttribute(\"data-ctx\");\n        if (!stat) return;\n\n        tooltip.innerHTML =\n          \"<strong class='gtip-stat'>\" + stat + \"</strong>\" +\n          \"<span class='gtip-ctx'>\" + ctx + \"</span>\";\n\n        // Center the tooltip in the galaxy wrapper\n        var wrap = svg.closest(\".galaxy-impact\");\n        var wW = wrap.offsetWidth;\n        var wH = wrap.offsetHeight;\n        var tipW = 220;\n        var tipH = 80;\n        var left = (wW - tipW) / 2;\n        var top  = (wH - tipH) / 2;\n\n        tooltip.style.left    = left + \"px\";\n        tooltip.style.top     = top  + \"px\";\n        tooltip.style.width   = tipW + \"px\";\n        tooltip.style.opacity = \"1\";\n        tooltip.style.transform = \"translateY(0) scale(1)\";\n\n        // Glow the hovered star\n        star.setAttribute(\"r\", parseFloat(star.getAttribute(\"r\")) * 1.55 + \"\");\n      });\n\n      star.addEventListener(\"mouseleave\", function () {\n        tooltip.style.opacity = \"0\";\n        tooltip.style.transform = \"translateY(4px)\";\n        // Reset radius (stored in data attribute)\n        var origR = star.getAttribute(\"data-orig-r\");\n        if (origR) { star.setAttribute(\"r\", origR); }\n      });\n\n      // Store original radius once\n      star.setAttribute(\"data-orig-r\", star.getAttribute(\"r\"));\n    });\n  }\n\n  // ── CUSTOM CAT CURSOR (cat face only — no paw swap) ──────────\n  function initCatCursor() {\n    var isTouch = window.matchMedia && window.matchMedia(\"(pointer: coarse)\").matches;\n    if (isTouch) return;\n\n    document.documentElement.classList.add(\"has-custom-cursor\");\n\n    var cursorEl = document.createElement(\"div\");\n    cursorEl.id = \"cat-cursor\";\n\n    // ── CAT FACE ─────────────────────────────────────\n    // Nose uses --cursor-nose which is blue in BOTH modes so it\n    // never camouflages against the body colour. This is the\n    // only cursor state — it never swaps to a paw on hover,\n    // it just scales up slightly (see .is-hover in custom.scss).\n    var faceSVG =\n      '<g id=\"cat-face\">' +\n        // Body\n        '<ellipse cx=\"50\" cy=\"60\" rx=\"32\" ry=\"26\" fill=\"var(--cursor-fill)\"/>' +\n        // Outer ears\n        '<path d=\"M 22 38 L 12 12 L 38 30 Z\" fill=\"var(--cursor-fill)\"/>' +\n        '<path d=\"M 78 38 L 88 12 L 62 30 Z\" fill=\"var(--cursor-fill)\"/>' +\n        // Inner ear colour\n        '<path d=\"M 26 36 L 20 18 L 36 28 Z\" fill=\"var(--cursor-accent)\"/>' +\n        '<path d=\"M 74 36 L 80 18 L 64 28 Z\" fill=\"var(--cursor-accent)\"/>' +\n        // Eye whites\n        '<ellipse cx=\"38\" cy=\"56\" rx=\"5.5\" ry=\"7\" fill=\"var(--cursor-eye-white)\"/>' +\n        '<ellipse cx=\"62\" cy=\"56\" rx=\"5.5\" ry=\"7\" fill=\"var(--cursor-eye-white)\"/>' +\n        // Pupils\n        '<ellipse cx=\"38\" cy=\"58\" rx=\"2.8\" ry=\"4\" fill=\"var(--cursor-pupil)\"/>' +\n        '<ellipse cx=\"62\" cy=\"58\" rx=\"2.8\" ry=\"4\" fill=\"var(--cursor-pupil)\"/>' +\n        // BLUE NOSE — always visible in day and night mode\n        '<ellipse cx=\"50\" cy=\"68\" rx=\"3.8\" ry=\"2.8\" fill=\"var(--cursor-nose)\"/>' +\n        // Mouth lines\n        '<path d=\"M 50 71 Q 44 75 40 73\" stroke=\"var(--cursor-nose)\" stroke-width=\"1\" fill=\"none\" opacity=\"0.6\"/>' +\n        '<path d=\"M 50 71 Q 56 75 60 73\" stroke=\"var(--cursor-nose)\" stroke-width=\"1\" fill=\"none\" opacity=\"0.6\"/>' +\n      '</g>';\n\n    cursorEl.innerHTML =\n      '<svg viewBox=\"0 0 100 100\" id=\"cat-cursor-svg\">' +\n        faceSVG +\n      '</svg>';\n\n    document.body.appendChild(cursorEl);\n\n    // Restore the last known pointer position from the previous\n    // page (this is a multi-page site, so every navigation is a\n    // full reload and JS state — including mouseX/mouseY — is\n    // lost). Without this, the cursor always re-initializes at\n    // the viewport center and only catches up to the real pointer\n    // once the user moves the mouse, which looks like the cat\n    // cursor \"disappearing\" after every click to a new section.\n    var CURSOR_POS_KEY = \"anu-cursor-pos\";\n    var startX = window.innerWidth / 2, startY = window.innerHeight / 2;\n    try {\n      var saved = JSON.parse(sessionStorage.getItem(CURSOR_POS_KEY));\n      if (saved && typeof saved.x === \"number\" && typeof saved.y === \"number\") {\n        startX = saved.x;\n        startY = saved.y;\n      }\n    } catch (e) {}\n\n    var mouseX = startX, mouseY = startY;\n    var curX   = mouseX, curY = mouseY;\n\n    document.addEventListener(\"mousemove\", function (e) {\n      mouseX = e.clientX; mouseY = e.clientY;\n      try { sessionStorage.setItem(CURSOR_POS_KEY, JSON.stringify({ x: mouseX, y: mouseY })); } catch (err) {}\n    }, { passive: true });\n\n    var hoverSelector =\n      \"a, button, .nav-tile, .acad-card, .game-card, \" +\n      \".portfolio-card, .fb, .star-dot, .impact-filter-tab, \" +\n      \".volunteer-card, [onclick], \" +\n      \"input, select, textarea, .theme-toggle\";\n\n    document.addEventListener(\"mouseover\", function (e) {\n      if (e.target.closest && e.target.closest(hoverSelector)) {\n        cursorEl.classList.add(\"is-hover\");\n      }\n    });\n\n    document.addEventListener(\"mouseout\", function (e) {\n      if (e.target.closest && e.target.closest(hoverSelector)) {\n        cursorEl.classList.remove(\"is-hover\");\n      }\n    });\n\n    function animateCursor() {\n      curX += (mouseX - curX) * 0.25;\n      curY += (mouseY - curY) * 0.25;\n      cursorEl.style.left = curX + \"px\";\n      cursorEl.style.top  = curY + \"px\";\n      requestAnimationFrame(animateCursor);\n    }\n    animateCursor();\n  }\n\n  // ── GALAXY IMPACT FILTER TABS ─────────────────────────────────\n  // Clicking a category tab dims every cluster except the one\n  // selected, similar to the tabbed \"Impact\" stat board pattern.\n  function initGalaxyFilters() {\n    var tabs = document.querySelectorAll(\".impact-filter-tab\");\n    if (!tabs.length) return;\n    var svg = document.querySelector(\".constellation-svg\");\n    if (!svg) return;\n\n    tabs.forEach(function (tab) {\n      tab.addEventListener(\"click\", function () {\n        tabs.forEach(function (t) { t.classList.remove(\"on\"); });\n        tab.classList.add(\"on\");\n        var cluster = tab.getAttribute(\"data-cluster\");\n\n        svg.querySelectorAll(\"[data-cluster]\").forEach(function (group) {\n          if (cluster === \"all\" || group.getAttribute(\"data-cluster\") === cluster) {\n            group.style.opacity = \"1\";\n            group.style.pointerEvents = \"\";\n          } else {\n            group.style.opacity = \"0.12\";\n            group.style.pointerEvents = \"none\";\n          }\n        });\n      });\n    });\n  }\n\n  // ── BOOT ────────────────────────────────────────────────────\n  function init() {\n    injectToggleButton();\n    initScrollZoom();\n    initGalaxyTooltips();\n    initGalaxyFilters();\n    initCatCursor();\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", init);\n  } else {\n    init();\n  }\n})();\n</script>\n"}],"output-file":"awards.html"},"language":{"toc-title-document":"Table of contents","toc-title-website":"On this page","related-formats-title":"Other Formats","related-notebooks-title":"Notebooks","source-notebooks-prefix":"Source","other-links-title":"Other Links","code-links-title":"Code Links","launch-dev-container-title":"Launch Dev Container","launch-binder-title":"Launch Binder","article-notebook-label":"Article Notebook","notebook-preview-download":"Download Notebook","notebook-preview-download-src":"Download Source","notebook-preview-back":"Back to Article","manuscript-meca-bundle":"MECA Bundle","section-title-abstract":"Abstract","section-title-appendices":"Appendices","section-title-footnotes":"Footnotes","section-title-references":"References","section-title-reuse":"Reuse","section-title-copyright":"Copyright","section-title-citation":"Citation","appendix-attribution-cite-as":"For attribution, please cite this work as:","appendix-attribution-bibtex":"BibTeX citation:","appendix-view-license":"View License","title-block-author-single":"Author","title-block-author-plural":"Authors","title-block-affiliation-single":"Affiliation","title-block-affiliat